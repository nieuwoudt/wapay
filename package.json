{
  "name": "wapay",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@8.15.4",
  "scripts": {
    "postinstall": "prisma generate --schema=./packages/domain/prisma/schema.prisma",
    "build": "pnpm run build:packages && next build",
    "build:packages": "pnpm -r --filter='./packages/**' run build",
    "dev": "next dev",
    "start": "next start",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "format": "prettier -w .",
    "dev:api": "pnpm --filter @wapay/api dev",
    "dev:ops": "pnpm --filter @wapay/ops dev",
    "prisma:generate": "prisma generate --schema=./packages/domain/prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.11.0",
    "@wapay/ai": "workspace:*",
    "@wapay/auth": "workspace:*",
    "@wapay/domain": "workspace:*",
    "@wapay/ledger": "workspace:*",
    "@wapay/nlp": "workspace:*",
    "@wapay/providers-blu": "workspace:*",
    "@wapay/providers-yoyo": "workspace:*",
    "@wapay/utils": "workspace:*",
    "@wapay/whatsapp": "workspace:*",
    "argon2": "^0.31.2",
    "jose": "^6.1.1",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "undici": "^7.16.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/react": "^18.3.0",
    "prettier": "^3.3.3",
    "prisma": "^5.11.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}

# OTT REDEMPTION (merchant) rail — cash-in from the OTT voucher network.
# Spec v6 received 2026-09-04 (docs/OTT_REDEMPTION_API.md). LIVE base URL is
# the same host WITHOUT the "test-" prefix. Credentials come from the
# MERCHANT portal (partner.ott-mobile.com, API Settings) and are DIFFERENT
# from the issuing credentials. NEVER call GetAPIKey: it rotates the key.
OTT_MERCHANT_BASE_URL=https://test-api.ott-mobile.com
OTT_MERCHANT_API_USERNAME=
OTT_MERCHANT_API_PASSWORD=
OTT_MERCHANT_API_KEY=
# OTT-assigned vendor id (WaPay = 11)
OTT_VENDOR_CODE=11

# UniFuel / wiCode service link (v1.3 — docs/UNIFUEL_INTEGRATION.md)
# The shared partner secret also goes into the UniFuel Vercel project as
# WAPAY_PARTNER_SECRET. Rotation = set a new random value in both projects.
UNIFUEL_API_BASE_URL=https://unifuel.co
UNIFUEL_PARTNER_SECRET=
# Optional dedicated inbound-webhook secret (falls back to the partner secret)
# UNIFUEL_WEBHOOK_SECRET=

# Admin console password sign-in (2026-08-30). ONE argon2id hash, generated
# with scripts/hash-admin-password.mjs — the password itself is never stored
# anywhere. Unset = password login hidden, WhatsApp-code login still works.
WAPAY_ADMIN_PASSWORD_HASH=

# wiCode PRODUCTION flag: 'true' opens the customer-facing fuel flow AND
# real-redemption claims. Stays unset/false while Yoyo is in TEST mode.
WAPAY_WICODE_LIVE=

# Fuel purchase tuning (integer cents; defaults R50 / R5000 / R0 fee / 0 bps)
# WAPAY_FUEL_MIN_CENTS=5000
# WAPAY_FUEL_MAX_CENTS=500000
# WAPAY_FUEL_FLAT_FEE_CENTS=0
# WAPAY_WICODE_COMMISSION_BPS=0
# Pilot rollout: with WAPAY_WICODE_LIVE=true, restrict the live fuel flow
# to these waIds (comma-separated); unset = live for everyone.
# VAS_ALLOWLIST_FUEL=27787051175
# Merchant catalogue JSON override (grows without a deploy of new code)
# WAPAY_WICODE_CATALOGUE_JSON=

# Supplier floats card (Mission Control) — low-float alarm lines, integer cents
# WAPAY_FLOAT_WARN_CENTS=50000
# WAPAY_FLOAT_WARN_CENTS_OTT=
# WAPAY_FLOAT_WARN_CENTS_OTT_PAYOUT=

# WaPay email (Resend, WaPay's OWN account — never UniFuel's identity).
# Verify wapay.co.za in Resend before customer-facing mail.
RESEND_API_KEY=
WAPAY_EMAIL_FROM="WaPay <noreply@wapay.co.za>"
ALERT_EMAIL=

# Cash-out pilot gate. WAPAY_PAYOUT_ENABLED=true alone opens withdrawal to
# EVERY customer in chat. While counsel clearance is outstanding, list the
# waIds allowed to withdraw here; unset means everyone who passes the other
# gates. Note WAPAY_PAYOUT_KYC=off REMOVES the identity check entirely,
# which contradicts the locked "KYC on withdrawal only" model.
# WAPAY_PAYOUT_ALLOWLIST=27787051175

# Growth (Mission Control → Growth tab, 2026-10-10). All optional; the tab
# shows what is measurable without them (the funnel from our own data).
# Meta Marketing API, read-only: a System User token with ads_read on the ad
# account, and the ad account id (digits; "act_" prefix optional).
META_ADS_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
# Conversions API for Business Messaging (sends LeadSubmitted / QualifiedLead
# / Purchase back to Meta so delivery optimises for funded accounts). The
# dataset is the one linked to the WABA (create it with
# POST /api/internal/capi-dataset, internal key, production only). The token
# is META_CAPI_ACCESS_TOKEN or, by default, the Growth token in
# META_ADS_ACCESS_TOKEN; the bot's messaging token is never used. OFF until
# the dataset id is set.
META_CAPI_DATASET_ID=
META_CAPI_ACCESS_TOKEN=
# Meta's Test Events tool code, while verifying; unset in production.
# META_CAPI_TEST_EVENT_CODE=
# Events only ever send from the Production environment (VERCEL_ENV); a
# preview build reports "held". Set this ONLY for a local run against the
# Test Events tool.
# META_CAPI_ALLOW_NON_PRODUCTION=true
# Read-only pipe check (internal key): GET /api/internal/ads-pipe-check
# (add ?waba=<id> to also read a WhatsApp account by id). One synthetic test
# event through the real sender, only with a test code (POST body
# {"testEventCode":"TEST…"} or this env): POST /api/internal/capi-test-send
# (internal key, production only).
# The Scale Model artifact the Growth tab opens with measured inputs.
# WAPAY_SCALE_MODEL_URL=https://claude.ai/artifact/2qy3TYNL6149xuT5FBZj8R

# Ad chat flow (docs/AD_CHAT_FLOW.md). A late amount in the first-link step still
# counts for this many hours after the prompt (default 24); past it the state expires.
# WAPAY_AD_FIRST_LINK_RESUME_HOURS=24
# Chat harness: the fresh QA number used by the ad-arrival scenarios (never a real customer).
# CHAT_QA_AD_WA_ID=27600000902

# Launch scope (docs/LAUNCH_SCOPE.md, 2026-10-18). All OFF by default: customers read
# "coming soon". Set =true to switch one on for everyone; add VAS_ALLOWLIST_<KEY>=27…,27…
# to narrow an ON switch to testers. Read at call time: no cold start needed.
# VAS_LIVE_AIRTIME=true
# VAS_LIVE_DATA=true
# VAS_LIVE_ELECTRICITY=true
# VAS_LIVE_BLU_LOAD=true          # cash top-ups with a Blu voucher PIN
# VAS_LIVE_OTT_LOAD=true          # top-ups with an OTT voucher PIN (also needs OTT_MERCHANT_API_KEY)
# VAS_LIVE_OTT_VOUCHER=true       # buying a WaPay (OTT) voucher for yourself
# The master hold (CHANGELOG 93): unset = every product above is off for everyone, whatever
# the per-product switches and allowlists say. Set =off to release it.
# WAPAY_LAUNCH_HOLD=off

# Operator alerts (CHANGELOG 94): a WhatsApp line when money lands from outside, with the
# pay-out float position, and when a pay-out leaves the float thin. Unset = logged only.
# WAPAY_OPS_ALERT_MSISDNS=27787051175
# WAPAY_OPS_ALERT_MIN_CENTS=0
# An approved one-parameter utility template for alerts outside the recipient's 24-hour window.
# WAPAY_TEMPLATE_OPS_ALERT=

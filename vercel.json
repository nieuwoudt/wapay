{
  "version": 2,
  "buildCommand": null,
  "installCommand": "pnpm install && pnpm --filter @wapay/domain prisma:generate",
  "builds": [
    {
      "src": "apps/api/src/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["packages/**", "apps/api/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "apps/api/src/index.ts"
    }
  ]
}

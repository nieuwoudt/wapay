// datasource & generator
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                 String   @id @default(cuid())
  waId               String   @unique
  msisdn             String
  displayName        String?
  status             String?  @default("ACTIVE")
  onboardingState    String?  @default("S0_INITIAL")
  onboardingStatus   String?  @default("NEW")
  conversationState  String?
  conversationData   Json?
  createdAt          DateTime @default(now())
  wallets            Wallet[]
  sessions           AuthSession[]
  limits             Limit[]
  yoyo               YoyoInstrument?
  otpCodes           OtpCode[]
  authFactors        AuthFactor[]
  consents           Consent[]
  auditLogs          AuditLog[]
}

model Wallet {
  id            String   @id @default(cuid())
  account       Account  @relation(fields: [accountId], references: [id])
  accountId     String
  currency      String   @default("ZAR")
  availableCents Int     @default(0)
  pendingCents   Int     @default(0)
}

model JournalEntry {
  id          String   @id @default(cuid())
  externalRef String?
  source      String
  createdAt   DateTime @default(now())
  lines       JournalLine[]
}

model JournalLine {
  id         String        @id @default(cuid())
  entry      JournalEntry  @relation(fields: [entryId], references: [id])
  entryId    String
  accountCode String
  debitCents  Int?
  creditCents Int?
}

model ProviderRequest {
  id             String   @id @default(cuid())
  provider       String
  route          String
  idemKey        String   @unique
  requestTs      DateTime @default(now())
  status         String
  providerRef    String?
  redactedPayload String?
  responseJson   String?
  accountId      String?
  metadata       Json?

  @@index([accountId])
  @@index([status])
}

model AuthSession {
  id           String   @id @default(cuid())
  account      Account  @relation(fields: [accountId], references: [id])
  accountId    String
  lastPinAt    DateTime?
  deviceBinding String?
  expiresAt    DateTime?
}

model Limit {
  id               String   @id @default(cuid())
  account          Account  @relation(fields: [accountId], references: [id])
  accountId        String
  dailyCents       Int      @default(0)
  monthlyCents     Int      @default(0)
  usedTodayCents   Int      @default(0)
  usedMonthCents   Int      @default(0)
}

// VAS Product Categories
// AIRTIME | DATA | ELECTRICITY | LIFESTYLE | BILLPAY | REMITTANCE | GAMING
model VasProduct {
  id               String   @id @default(cuid())
  provider         String   @default("BLU")   // BLU, YOYO, etc.
  // Categories: AIRTIME | DATA | ELECTRICITY | LIFESTYLE | BILLPAY | REMITTANCE | GAMING
  category         String
  // Subcategory: PINNED | PINLESS | MUNICIPAL_ELEC | OTT | etc.
  subcategory      String?
  // Network for mobile: VODACOM | MTN | CELLC | TELKOM
  networkCode      String?
  // Operator: HOLLYWOODBETS, DSTV, ESKOM, etc.
  operatorCode     String?
  // Blu product / vendor code or identifier
  externalCode     String
  // Display label: "Vodacom 1GB Weekly", "R50 Electricity (Eskom)"
  label            String
  // For variable-amount products
  minCents         Int?
  maxCents         Int?
  stepCents        Int?
  // For fixed-price bundles/vouchers
  fixedPriceCents  Int?
  // Legacy priceCents kept for compatibility
  priceCents       Int      @default(0)
  // Bundle validity
  validityDays     Int?
  // Period type: DAILY | WEEKLY | MONTHLY | ONCE_OFF
  periodType       String?
  // Data size in MB (for data bundles)
  dataMb           Int?
  // Purchase types: INSTANT_VEND | PIN_BASED | TOKEN_BASED | REFERENCE_BASED
  purchaseType     String   @default("INSTANT_VEND")
  // Target types: MSISDN | METER_NUMBER | SMARTCARD | ACCOUNT_ID
  targetType       String   @default("MSISDN")
  // Priority for display ordering (lower = higher priority)
  priority         Int      @default(100)
  // Popularity score for "top products" queries
  popularity       Int      @default(0)
  // Extra metadata
  metadata         Json?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([provider, category, externalCode])
  @@index([category, networkCode])
  @@index([active, category])
  @@index([priority])
  @@index([popularity])
}

// User's saved accounts for quick reuse (meters, smartcards, betting accounts)
model UserSavedAccount {
  id              String   @id @default(cuid())
  accountId       String   // WaPay account ID
  // Categories: ELECTRICITY | PAYTV | BETTING
  category        String
  // Provider: dstv, hollywoodbets, etc.
  providerId      String?
  // Identifier: meter number, smartcard, betting account
  identifier      String
  // User-friendly name: "Home", "Mom's place"
  nickname        String?
  // Name from validation lookup
  customerName    String?
  metadata        Json?
  lastUsed        DateTime @default(now())
  createdAt       DateTime @default(now())

  @@unique([accountId, category, identifier])
  @@index([accountId, category])
  @@map("user_saved_accounts")
}

model YoyoInstrument {
  id            String  @id @default(cuid())
  account       Account @relation(fields: [accountId], references: [id])
  accountId     String  @unique
  yoyoAccountId String  @unique
  cardId        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model WhatsappTemplate {
  id             String   @id @default(cuid())
  wabaId         String
  name           String
  language       String
  status         String
  category       String?
  componentsHash String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([wabaId, name, language])
  @@index([wabaId, name])
}

model OtpCode {
  id         String    @id @default(cuid())
  account    Account   @relation(fields: [accountId], references: [id])
  accountId  String
  code       String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@map("otp_codes")
}

model AuthFactor {
  id          String    @id @default(cuid())
  account     Account   @relation(fields: [accountId], references: [id])
  accountId   String
  type        String
  secretHash  String
  attempts    Int       @default(0)
  lockedUntil DateTime?
  setAt       DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([accountId, type])
  @@map("auth_factors")
}

model Consent {
  id          String   @id @default(cuid())
  account     Account  @relation(fields: [accountId], references: [id])
  accountId   String
  consentType String
  granted     Boolean
  version     String
  ipAddress   String?
  userAgent   String?
  grantedAt   DateTime @default(now())

  @@map("consents")
}

model AuditLog {
  id          String   @id @default(cuid())
  account     Account  @relation(fields: [accountId], references: [id])
  accountId   String
  event       String
  metadata    Json?
  waMessageId String?
  ipAddress   String?
  userAgent   String?
  timestamp   DateTime @default(now())

  @@index([accountId, event])
  @@index([accountId, timestamp])
  @@map("audit_log")
}



{
  "name": "@wapay/domain",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "prisma": {
    "schema": "./prisma/schema.prisma"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && node scripts/fix-dist.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'no lint yet'",
    "prisma:generate": "prisma generate",
    "prisma:diff:init": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "@wapay/ledger": "workspace:*"
  },
  "devDependencies": {
    "prisma": "^5.18.0"
  }
}



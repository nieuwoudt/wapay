{
  "name": "@wapay/domain",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "prisma": {
    "schema": "./prisma/schema.prisma"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
